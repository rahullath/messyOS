---
// UK Student Life Optimization Dashboard
// Main dashboard page with real authentication and initialization check

import Layout from '../layouts/Layout.astro';
import { ImprovedDashboard } from '../components/uk-student/ImprovedDashboard';
import { createServerAuth } from '../lib/auth/simple-multi-user';
import { userInitService } from '../lib/uk-student/user-initialization';

// Require authentication
const serverAuth = createServerAuth(Astro.cookies);
const user = await serverAuth.getUser();

if (!user) {
  return Astro.redirect('/login');
}

// Check if user has completed onboarding
const isInitialized = await userInitService.isUserInitialized(user.id);

if (!isInitialized) {
  return Astro.redirect('/uk-student-onboarding');
}

// Create minimal profile for component
const profile = {
  userId: user.id,
  preferences: {
    cooking_time_limits: {
      breakfast: 10,
      lunch: 20,
      dinner: 30
    },
    dietary_restrictions: [],
    home_location: 'five-ways',
    transport_preference: 'mixed' as const,
    budget_alert_enabled: true,
    weather_notifications: true,
    laundry_reminder_enabled: true,
    skincare_tracking_enabled: true
  },
  transport_preferences: {
    preferred_method: 'mixed' as const,
    weather_threshold: 0.7,
    cost_sensitivity: 'medium' as const,
    time_sensitivity: 'medium' as const
  },
  academic_schedule: [],
  active_routines: [],
  budget_limits: [],
  dietary_preferences: {
    restrictions: [],
    allergies: [],
    preferred_cuisines: [],
    cooking_skill_level: 3 as const,
    meal_prep_preference: 'mixed' as const
  }
};
---

<Layout title="UK Student Dashboard">
  <ImprovedDashboard
    userId={user.id}
    profile={profile}
    client:load
  />
</Layout>

<style>
  /* Force light theme for UK Student Dashboard */
  body {
    background-color: #f9fafb !important;
    color: #111827 !important;
  }
</style>
